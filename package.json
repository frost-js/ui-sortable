{
    "name": "@fr0st/ui-sortable",
    "version": "3.0.0",
    "private": false,
    "description": "Drag-and-drop sortable lists for Frost UI with handles, connected containers, axis control, and automatic scrolling.",
    "keywords": [
        "component",
        "drag-and-drop",
        "frost",
        "frontend",
        "javascript",
        "sortable",
        "ui"
    ],
    "homepage": "https://github.com/frost-js/ui-sortable",
    "bugs": {
        "url": "https://github.com/frost-js/ui-sortable/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frost-js/ui-sortable.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-ui-sortable.esm.js",
            "default": "./dist/frost-ui-sortable.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-ui-sortable.esm.js",
    "jsdelivr": "./dist/frost-ui-sortable.min.js",
    "unpkg": "./dist/frost-ui-sortable.min.js",
    "module": "./dist/frost-ui-sortable.esm.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode umd",
        "lint": "eslint"
    },
    "browserslist": [
        "baseline newly available"
    ],
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.3",
        "@fr0st/query": "^4.1.2",
        "@fr0st/ui": "^3.0.0",
        "eslint": "^10.9.1",
        "vite": "^8.2.2"
    },
    "peerDependencies": {
        "@fr0st/query": "^4.1.2",
        "@fr0st/ui": "^3.0.0"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
